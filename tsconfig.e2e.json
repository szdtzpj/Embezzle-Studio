{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "tests/e2e/**/*.ts",
    "tests/e2e/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.e2e.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "web-build",
    ".expo"
  ]
}
