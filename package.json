  "main": "index.ts",
  "dependencies": {
    "@lobehub/icons-rn": "^2.8.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.4",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-background-task": "~57.0.2",
    "expo-blur": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "^57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-task-manager": "~57.0.2",
    "expo-video": "~57.0.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^9.1.0",
    "lucide-react-native": "^1.23.0",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "fake-indexeddb": "^6.2.4",
    "jimp-compact": "0.16.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.65.1",
    "pngjs": "3.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/start-web.mjs",
    "web:expo": "expo start --web",
    "web:proxy": "node scripts/dev-proxy.mjs",
    "build:web": "expo export --platform web --output-dir dist",
    "typecheck": "node --stack_size=16384 ./node_modules/typescript/lib/tsc.js --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck:e2e": "node --stack_size=16384 ./node_modules/typescript/lib/tsc.js -p tsconfig.e2e.json --noEmit",
    "lint:e2e": "node ./node_modules/eslint/bin/eslint.js --no-ignore --max-warnings=0 tests/e2e/helpers/*.ts tests/e2e/r1/*.e2e.spec.ts tests/e2e/r2/*.e2e.spec.ts tests/e2e/r3/*.e2e.spec.ts tests/e2e/tier3/*.e2e.spec.ts tests/e2e/tier4/*.e2e.spec.ts tests/e2e/web/*.mjs",
    "test:e2e:core": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:web": "node tests/e2e/web/run-web-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "postinstall": "patch-package"
  },
  "private": true
}
